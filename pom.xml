<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>skaro.pokeapi</groupId>
    <artifactId>pokeapi-reactor</artifactId>
    <version>2.0.0</version>
    <name>pokeapi-reactor</name>
    <description>Non-blocking, reactive API client for PokeAPI</description>
    <url>https://pokeapi.co</url>

    <properties>
        <java.version>21</java.version>
        <jacoco.maven.plugin.version>0.8.14</jacoco.maven.plugin.version>
        <javax.validation.version>3.1.1</javax.validation.version>
        <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
        <!-- test dependencies versions -->
        <okhttp3.version>4.10.0</okhttp3.version>
    </properties>

    <dependencies>
        <!-- Spring Boot WebFlux Starter --><!--
             Wires Reactor in and (by default) uses reactor-netty
             as the runtime. Controllers or functional handlers
             return Mono/Flux. WebClient is the reactive HTTP client
             provided by WebFlux and returns Reactor types. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Spring Boot Validation Starter --><!--
             Provides support for validating
             method parameters and return values
             using Jakarta Bean Validation API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Reactor-core --><!--
             Provides core classes used to build
             non-blocking reactive applications on the JVM. -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <!-- Reactor-extra --><!--
             Offers additional operators, utilities,
             and extensions to enhance the capabilities
             of Reactor Core. -->
        <dependency>
            <groupId>io.projectreactor.addons</groupId>
            <artifactId>reactor-extra</artifactId>
        </dependency>
        <!-- Reactor-netty --><!--
             Netty-based reactive networking implementation used for non-blocking
             HTTP/TCP clients and servers (used by Spring WebFlux as the default
             reactive HTTP runtime).
              -->
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${javax.validation.version}</version>
        </dependency>

        <!-- Test Dependencies -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp3.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>${okhttp3.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>

        <plugins>
            <!-- This plugin is used to package and run Spring Boot applications. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Attach sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven.source.plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- configures the JaCoCo Maven plugin for code coverage analysis in the project. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.maven.plugin.version}</version>
                <configuration>
                    <!-- Exclude classes from code coverage -->
                    <excludes>
                        <exclude>**/*Configuration.class</exclude> <!-- Exclude @Configuration classes -->
                        <exclude>**/*Properties.class</exclude> <!-- Exclude properties classes -->
                        <exclude>skaro/pokeapi/resource/**/*</exclude> <!-- Exclude POJOs -->
                    </excludes>
                </configuration>
                <executions>
                    <!-- prepares the JaCoCo agent -->
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- generates the code coverage report during the test phase -->
                    <execution>
                        <id>generate-code-coverage-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>PokeAPI Reactor Packages</name>
            <url>https://maven.pkg.github.com/SirSkaro/pokeapi-reactor</url>
        </repository>
    </distributionManagement>

</project>
